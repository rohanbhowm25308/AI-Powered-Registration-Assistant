# Copy this file to ".env" in the backend/ folder and fill in ONE provider.
# If GENAI_PROVIDER is left blank (or its key is missing), the chatbot
# automatically falls back to a rule-based responder -- the app still works
# with zero API keys, just with simpler chat replies.

# One of: openai | gemini | groq | (blank)
GENAI_PROVIDER=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
